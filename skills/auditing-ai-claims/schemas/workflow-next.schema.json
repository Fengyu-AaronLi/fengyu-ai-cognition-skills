{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/auditing-ai-claims/workflow-next.schema.json",
  "title": "AI claim audit next transition",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "workflow_version",
    "runtime_version",
    "audit_id",
    "complete",
    "stage",
    "next_steps"
  ],
  "properties": {
    "workflow_version": {"const": "1.0"},
    "runtime_version": {"type": "string", "minLength": 1},
    "audit_id": {"type": "string", "minLength": 1},
    "complete": {"type": "boolean"},
    "stage": {
      "enum": [
        "claim_extraction",
        "claim_assessment",
        "claim_countercheck",
        "audit_summary",
        "gate_repair",
        "ready_to_finish",
        "complete",
        "not_triggered"
      ]
    },
    "next_steps": {
      "type": "array",
      "items": {"$ref": "#/$defs/next_step"}
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"stage": {"enum": ["complete", "not_triggered"]}},
        "required": ["stage"]
      },
      "then": {
        "properties": {
          "complete": {"const": true},
          "next_steps": {"maxItems": 0}
        }
      },
      "else": {
        "properties": {
          "complete": {"const": false},
          "next_steps": {"minItems": 1}
        }
      }
    }
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "candidate_id": {"type": "string", "pattern": "^U[0-9]{3,}$"},
    "claim_id": {"type": "string", "minLength": 1},
    "source_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "path", "message"],
      "properties": {
        "code": {"type": "string", "minLength": 1},
        "path": {"type": "string"},
        "message": {"type": "string", "minLength": 1}
      }
    },
    "safe_file_inputs": {"const": ["--workspace", "--file"]},
    "next_step": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "action",
            "cli_subcommand",
            "required_inputs",
            "why",
            "candidate_id"
          ],
          "properties": {
            "action": {"const": "add_claim"},
            "cli_subcommand": {"const": "claim"},
            "required_inputs": {"$ref": "#/$defs/safe_file_inputs"},
            "why": {"type": "string", "minLength": 1},
            "candidate_id": {
              "oneOf": [
                {"$ref": "#/$defs/candidate_id"},
                {"type": "null"}
              ]
            },
            "candidate_sha256": {"$ref": "#/$defs/sha256"},
            "candidate_origin": {"const": "declared"},
            "missing_fields": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {"type": "string", "minLength": 1}
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "action",
            "cli_subcommand",
            "required_inputs",
            "why",
            "candidate_id",
            "candidate_sha256",
            "candidate_origin",
            "factual_alternative",
            "allowed_exclusions"
          ],
          "properties": {
            "action": {"const": "classify_candidate"},
            "cli_subcommand": {"const": "exclude-candidate"},
            "required_inputs": {
              "const": [
                "--workspace",
                "--candidate-id",
                "--classification",
                "--reason"
              ]
            },
            "why": {"type": "string", "minLength": 1},
            "candidate_id": {"$ref": "#/$defs/candidate_id"},
            "candidate_sha256": {"$ref": "#/$defs/sha256"},
            "candidate_origin": {"const": "auto_gap"},
            "factual_alternative": {
              "type": "object",
              "additionalProperties": false,
              "required": ["cli_subcommand", "required_inputs"],
              "properties": {
                "cli_subcommand": {"const": "claim"},
                "required_inputs": {"$ref": "#/$defs/safe_file_inputs"}
              }
            },
            "allowed_exclusions": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "enum": [
                  "opinion",
                  "metaphor",
                  "creative_writing",
                  "personal_feeling",
                  "instruction",
                  "relationship_motive",
                  "other_nonfactual"
                ]
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "action",
            "cli_subcommand",
            "required_inputs",
            "why",
            "claim_id",
            "missing_evidence_purposes",
            "suggested_action",
            "source_count"
          ],
          "properties": {
            "action": {"const": "assess"},
            "cli_subcommand": {"const": "assess"},
            "required_inputs": {"$ref": "#/$defs/safe_file_inputs"},
            "why": {"type": "string", "minLength": 1},
            "claim_id": {"$ref": "#/$defs/claim_id"},
            "missing_evidence_purposes": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "enum": [
                  "substantive",
                  "study_design",
                  "source_identity",
                  "currentness"
                ]
              }
            },
            "suggested_action": {"type": "string", "minLength": 1},
            "source_count": {"type": "integer", "minimum": 0}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "action",
            "cli_subcommand",
            "required_inputs",
            "required_options",
            "why",
            "claim_id",
            "missing_fields",
            "runtime_generated_fields"
          ],
          "properties": {
            "action": {"const": "countercheck"},
            "cli_subcommand": {"const": "countercheck"},
            "required_inputs": {"$ref": "#/$defs/safe_file_inputs"},
            "required_options": {"$ref": "#/$defs/safe_file_inputs"},
            "why": {"type": "string", "minLength": 1},
            "claim_id": {"$ref": "#/$defs/claim_id"},
            "missing_fields": {
              "const": [
                "falsifier",
                "checked_source_ids",
                "result",
                "stop_reason"
              ]
            },
            "runtime_generated_fields": {"const": ["checked_at", "basis_hash"]}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "action",
            "cli_subcommand",
            "required_inputs",
            "why",
            "claim_ids"
          ],
          "properties": {
            "action": {"const": "summarize"},
            "cli_subcommand": {"const": "summarize"},
            "required_inputs": {"$ref": "#/$defs/safe_file_inputs"},
            "why": {"type": "string", "minLength": 1},
            "claim_ids": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {"$ref": "#/$defs/claim_id"}
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "action",
            "cli_subcommand",
            "required_inputs",
            "why",
            "errors",
            "recoverable_sources",
            "abortable_transactions"
          ],
          "properties": {
            "action": {"const": "repair_gate"},
            "cli_subcommand": {"const": "check"},
            "required_inputs": {"const": ["--workspace"]},
            "why": {"type": "string", "minLength": 1},
            "errors": {"type": "array", "items": {"$ref": "#/$defs/finding"}},
            "recoverable_sources": {
              "type": "array",
              "uniqueItems": true,
              "items": {"$ref": "#/$defs/source_id"}
            },
            "abortable_transactions": {
              "type": "array",
              "uniqueItems": true,
              "items": {"$ref": "#/$defs/source_id"}
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "action",
            "cli_subcommand",
            "required_inputs",
            "why",
            "source_id"
          ],
          "properties": {
            "action": {"const": "abort_source_transaction"},
            "cli_subcommand": {"const": "abort-source-transaction"},
            "required_inputs": {
              "const": ["--workspace", "--source-id", "--reason"]
            },
            "why": {"type": "string", "minLength": 1},
            "source_id": {"$ref": "#/$defs/source_id"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "action",
            "cli_subcommand",
            "required_inputs",
            "why",
            "bundle_sha256"
          ],
          "properties": {
            "action": {"const": "finish"},
            "cli_subcommand": {"const": "finish"},
            "required_inputs": {"const": ["--workspace"]},
            "why": {"type": "string", "minLength": 1},
            "bundle_sha256": {"$ref": "#/$defs/sha256"}
          }
        }
      ]
    }
  }
}
