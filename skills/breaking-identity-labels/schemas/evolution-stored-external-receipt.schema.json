{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fengyu.local/schemas/breaking-identity-labels/evolution-stored-external-receipt.schema.json",
  "title": "Stored external evolution step receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "candidate_id",
    "workflow_sha256",
    "step_id",
    "kind",
    "status",
    "summary",
    "evidence",
    "source_sha256",
    "recorded_at"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "run_id": {"type": "string", "minLength": 1},
    "candidate_id": {"type": "string", "minLength": 1},
    "workflow_sha256": {"$ref": "#/$defs/sha256"},
    "step_id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$"},
    "kind": {"const": "external"},
    "status": {"const": "completed"},
    "summary": {"type": "string", "minLength": 1},
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "sha256": {"$ref": "#/$defs/sha256"}
        }
      }
    },
    "source_sha256": {"$ref": "#/$defs/sha256"},
    "recorded_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
