{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/defining-problems-before-prompts/problem-state.schema.json",
  "title": "Defining Problems Evidence Loop State",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "request_sha256",
    "revision",
    "round",
    "phase",
    "stop_reason",
    "mode",
    "original_request",
    "spec",
    "pending_questions",
    "answers",
    "evidence_log",
    "events",
    "budget",
    "usage",
    "validation_status",
    "convergence",
    "user_decisions"
  ],
  "$defs": {
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "question", "changes", "addresses"],
      "properties": {
        "id": {"type": "string", "pattern": "^q[1-3]$"},
        "question": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "changes": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "addresses": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^u[1-9][0-9]*$"}
        }
      }
    }
  },
  "properties": {
    "schema_version": {"const": "2.1"},
    "request_id": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "request_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "revision": {"type": "integer", "minimum": 1},
    "round": {"type": "integer", "minimum": 1, "maximum": 10},
    "phase": {
      "enum": [
        "awaiting_answers",
        "needs_reassessment",
        "ready_for_answer",
        "awaiting_user_decision",
        "budget_exhausted",
        "user_decision_recorded"
      ]
    },
    "stop_reason": {
      "type": ["string", "null"],
      "enum": [
        null,
        "problem_defined",
        "value_tradeoff_requires_user",
        "max_rounds_reached",
        "user_decision_recorded"
      ]
    },
    "mode": {"enum": ["define", "defer_to_user"]},
    "original_request": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "spec": {"$ref": "problem-spec.schema.json"},
    "pending_questions": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "question", "changes", "addresses"],
        "properties": {
          "id": {"type": "string", "pattern": "^q[1-3]$"},
          "question": {"type": "string", "minLength": 1, "pattern": "\\S"},
          "changes": {"type": "string", "minLength": 1, "pattern": "\\S"},
          "addresses": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^u[1-9][0-9]*$"}
          }
        }
      }
    },
    "answers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "answer_id", "question_id", "answer", "round", "source_id", "status", "superseded_by"
        ],
        "properties": {
          "answer_id": {"type": "string", "minLength": 1, "pattern": "\\S"},
          "question_id": {"type": "string", "pattern": "^q[1-3]$"},
          "answer": {"type": "string", "minLength": 1, "pattern": "\\S"},
          "round": {"type": "integer", "minimum": 1},
          "source_id": {"type": "string", "minLength": 1, "pattern": "\\S"},
          "status": {"enum": ["active", "superseded"]},
          "superseded_by": {"type": ["string", "null"]}
        }
      }
    },
    "evidence_log": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_id", "kind", "text", "sha256", "status", "superseded_by"],
        "properties": {
          "source_id": {"type": "string", "minLength": 1, "pattern": "\\S"},
          "kind": {"enum": ["original_request", "answer", "amendment", "decision_input"]},
          "text": {"type": "string", "minLength": 1, "pattern": "\\S"},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "status": {"enum": ["active", "superseded"]},
          "superseded_by": {"type": ["string", "null"]}
        }
      }
    },
    "events": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["event_id", "event_type", "payload_digest", "revision"],
        "properties": {
          "event_id": {"type": "string", "minLength": 1, "pattern": "\\S"},
          "event_type": {"enum": ["start", "answer", "advance", "amendment", "decision"]},
          "payload_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "revision": {"type": "integer", "minimum": 1}
        }
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_rounds"],
      "properties": {"max_rounds": {"type": "integer", "minimum": 1, "maximum": 10}}
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rounds", "questions_scheduled", "answers_recorded", "advances", "amendments", "user_decisions"
      ],
      "properties": {
        "rounds": {"type": "integer", "minimum": 1},
        "questions_scheduled": {"type": "integer", "minimum": 0},
        "answers_recorded": {"type": "integer", "minimum": 0},
        "advances": {"type": "integer", "minimum": 0},
        "amendments": {"type": "integer", "minimum": 0},
        "user_decisions": {"type": "integer", "minimum": 0}
      }
    },
    "validation_status": {"enum": ["valid", "needs_model_update"]},
    "convergence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "unresolved_unknown_ids"],
      "properties": {
        "status": {"enum": ["unresolved", "defined", "user_owned"]},
        "unresolved_unknown_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^u[1-9][0-9]*$"}
        }
      }
    },
    "user_decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["decision_id", "actor", "tradeoff_id", "selection", "source", "user_input"],
        "properties": {
          "decision_id": {"type": "string", "minLength": 1, "pattern": "\\S"},
          "actor": {"const": "user"},
          "tradeoff_id": {"type": "string", "pattern": "^t[1-9][0-9]*$"},
          "selection": {"type": "string", "minLength": 1, "pattern": "\\S"},
          "user_input": {"type": "string", "minLength": 1, "pattern": "\\S"},
          "source": {
            "type": "object",
            "additionalProperties": false,
            "required": ["source_id", "start", "end", "quote"],
            "properties": {
              "source_id": {"type": "string", "pattern": "^decision_input:\\S+$"},
              "start": {"type": "integer", "minimum": 0},
              "end": {"type": "integer", "minimum": 1},
              "quote": {"type": "string", "minLength": 1, "pattern": "\\S"}
            }
          }
        }
      }
    }
  }
}
