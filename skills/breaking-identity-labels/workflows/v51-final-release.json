{
  "schema_version": "1.0",
  "workflow_id": "breaking-identity-labels-v62-final-release",
  "description": "Current convergence workflow: verify portable historical red evidence, run the exact manifest-bound regression and evaluation, rebuild and replay a deterministic demo, bind an independently reviewed same-prompt live retest to the current Skill, runtime and rubric, prove package byte equivalence, and leave publication state unchanged.",
  "steps": [
    {
      "id": "historical_red_evidence_verify",
      "kind": "command",
      "depends_on": [],
      "description": "Verify an immutable historical assertion-failure receipt and its current registered successor without equating checkout roots.",
      "argv": [
        "{python}",
        "{root}/scripts/verify_red_evidence.py",
        "--root",
        "{root}",
        "--run-dir",
        "{root}/evals/runs/v15-real-001",
        "--step-id",
        "failed_receipt_red",
        "--test-path",
        "tests/test_v15_evolution_failed_receipt_integrity.py",
        "--test-manifest",
        "{root}/evals/test-generation-manifest.json"
      ],
      "input_files": [
        "evals/runs/v15-real-001/run-state.json",
        "evals/runs/v15-real-001/receipts/failed_receipt_red.json",
        "evals/runs/v15-real-001/raw/failed_receipt_red.stdout.txt",
        "evals/runs/v15-real-001/raw/failed_receipt_red.stderr.txt",
        "evals/test-generation-manifest.json",
        "tests/test_v15_evolution_failed_receipt_integrity.py",
        "workflows/v15-evolution.json"
      ],
      "expected": "exit_zero"
    },
    {
      "id": "audit_harness_selfcheck",
      "kind": "command",
      "depends_on": ["historical_red_evidence_verify"],
      "description": "Fail closed unless the four fixed audit suites, command inputs and package install/equivalence chain are present and shell-free.",
      "argv": [
        "{python}",
        "{root}/scripts/run_release_audits.py",
        "self-check"
      ],
      "input_files": [
        "evals/test-generation-manifest.json",
        "scripts/build_package.py",
        "scripts/verify_package_equivalence.py"
      ],
      "expected": "exit_zero"
    },
    {
      "id": "full_regression",
      "kind": "command",
      "depends_on": ["audit_harness_selfcheck"],
      "description": "Validate the closed-world test manifest and run exactly its hash-bound unittest modules.",
      "argv": [
        "{python}",
        "{root}/scripts/run_regressions.py",
        "--suite",
        "full",
        "--test-manifest",
        "{root}/evals/test-generation-manifest.json"
      ],
      "input_files": ["evals/test-generation-manifest.json"],
      "expected": "exit_zero"
    },
    {
      "id": "offline_eval",
      "kind": "command",
      "depends_on": ["full_regression"],
      "description": "Run the deterministic held-out evaluation and write a result bound to runtime, evaluator and four datasets.",
      "argv": [
        "{python}",
        "{root}/evals/run_v2_evals.py",
        "--output",
        "{run_dir}/offline-eval.json"
      ],
      "input_files": [
        "scripts/identity_label_case.py",
        "evals/heldout-cases.json",
        "evals/boundary-cases.json",
        "evals/cases.json",
        "evals/upgrade-cases.json",
        "tests/fixtures/valid-c01.json",
        "schemas/analysis.schema.json",
        "schemas/case.schema.json",
        "schemas/event-head.schema.json",
        "schemas/event.schema.json",
        "schemas/workflow-next.schema.json"
      ],
      "expected": "exit_zero"
    },
    {
      "id": "offline_eval_verify",
      "kind": "command",
      "depends_on": ["offline_eval"],
      "description": "Re-read the generated evaluation file and reject stale bindings or threshold drift.",
      "argv": [
