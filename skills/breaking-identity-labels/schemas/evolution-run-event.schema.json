{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fengyu.local/schemas/breaking-identity-labels/evolution-run-event.schema.json",
  "title": "Append-only evolution run event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_id",
    "run_id",
    "event_type",
    "recorded_at",
    "previous_event_sha256",
    "data",
    "event_sha256"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "event_id": {"type": "integer", "minimum": 1},
    "run_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,95}$"},
    "event_type": {
      "enum": [
        "run_started",
        "command_completed",
        "command_failed",
        "external_action_required",
        "external_action_completed",
        "run_completed",
        "run_failed"
      ]
    },
    "recorded_at": {"type": "string", "format": "date-time"},
    "previous_event_sha256": {
      "oneOf": [{"type": "null"}, {"$ref": "#/$defs/sha256"}]
    },
    "data": {"type": "object"},
    "event_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
