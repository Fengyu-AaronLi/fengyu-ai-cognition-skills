#!/usr/bin/env python3
"""Deterministic runtime for defining-problems-before-prompts.

The runtime deliberately does not decide what a user should value.  It gates
an already-declared set of signals, validates a model-authored Problem Spec,
renders that spec, and persists question/answer state without network access.
"""

from __future__ import annotations

import copy
import fcntl
import hashlib
import json
import os
import re
import sys
import tempfile
from pathlib import Path
from typing import Any, Iterable


SCHEMA_VERSION = "1.0"
STATE_SCHEMA_VERSION = "2.1"
SKILL_ROOT = Path(__file__).resolve().parents[1]
ROUTES_PATH = SKILL_ROOT / "runtime" / "routes.json"
STATE_SCHEMA_PATH = SKILL_ROOT / "schemas" / "problem-state.schema.json"
SPEC_SCHEMA_PATH = SKILL_ROOT / "schemas" / "problem-spec.schema.json"
VERSION_PATH = SKILL_ROOT / "VERSION"

USAGE = """Usage: dpbp <command> [options]

Commands:
  gate --offline      Route a request envelope from stdin.
  init                Build a deterministic Problem Spec draft from stdin.
  validate            Validate a Problem Spec from stdin.
  render              Render a validated Problem Spec from stdin.
  start --state PATH  Start resumable state from a valid spec.
  resume --state PATH Resume state with one answer from stdin.
  advance --state PATH
                      Validate a revised spec and advance or stop the loop.
  amend --state PATH  Supersede one recorded answer without erasing history.
  decide --state PATH Record a user-owned high-risk value decision.
  status --state PATH Read loop state and allowed next actions without writing.
  doctor              Check local runtime assets without modifying them.
  version             Print the VERSION file.
  help                Show this help.
"""

