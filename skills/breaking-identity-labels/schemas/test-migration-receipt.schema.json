{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fengyu.local/schemas/breaking-identity-labels/test-migration-receipt.schema.json",
  "title": "Frozen test contract migration receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "receipt_id",
    "test_path",
    "from_sha256",
    "to_sha256",
    "reason",
    "replacement_tests",
    "evidence",
    "reviewed_by",
    "reviewed_at"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "receipt_id": {"type": "string", "minLength": 1},
    "test_path": {"type": "string", "pattern": "^tests/test_.*\\.py$"},
    "from_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "to_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "reason": {"type": "string", "minLength": 20},
    "replacement_tests": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/hashed_path"}
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/hashed_path"}
    },
    "reviewed_by": {"type": "string", "minLength": 1},
    "reviewed_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "hashed_path": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
