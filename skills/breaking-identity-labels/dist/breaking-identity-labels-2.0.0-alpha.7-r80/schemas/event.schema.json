{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fengyu.local/schemas/breaking-identity-labels/event.schema.json",
  "title": "Identity label case event",
  "type": "object",
  "additionalProperties": false,
  "required": ["event_id", "revision", "type", "recorded_at", "previous_event_sha256", "snapshot_sha256", "snapshot", "event_sha256"],
  "properties": {
    "event_id": {"type": "string", "pattern": "^EVT-[0-9]{4}$"},
    "revision": {"type": "integer", "minimum": 0},
    "type": {"type": "string", "enum": ["init", "plan", "start", "record", "review"]},
    "recorded_at": {"type": "string", "minLength": 1},
    "operation_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "operation_fingerprint": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "user_confirmation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "sha256", "case_id", "pre_start_revision", "experiment_sha256"],
      "properties": {
        "text": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "case_id": {"type": "string", "minLength": 1},
        "pre_start_revision": {"type": "integer", "minimum": 0},
        "experiment_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "previous_event_sha256": {"type": ["string", "null"]},
    "snapshot_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "snapshot": {"type": "object"},
    "event_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  },
  "allOf": [
    {
      "if": {
        "properties": {"type": {"const": "start"}},
        "required": ["type"]
      },
      "then": {"required": ["user_confirmation"]}
    }
  ]
}
